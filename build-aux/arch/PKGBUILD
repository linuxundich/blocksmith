# Maintainer: Christoph Langner <mail@christoph-langner.de>
#
# Builds directly from a local checkout (`_projectdir` below) rather than a
# downloaded/copied source tarball - convenient for packaging a local
# development build, unlike a normal PKGBUILD meant for submission to a
# repository, which would instead fetch a specific tagged release.
#
# Run `makepkg` from a directory OUTSIDE `_projectdir`, not this file's own
# location inside it - `cargo`'s build-script fingerprinting walks the
# whole crate directory looking for the most-recently-modified file, and
# makepkg's own `pkg/`/`src/` staging directories landing inside that tree
# make that walk fail with a permission error the moment `pkg/` exists but
# isn't fully populated yet. Simplest: copy both this file and
# `blocksmith.install` (see `install=` below) somewhere else first, e.g.
# `cp PKGBUILD blocksmith.install /tmp/blocksmith-pkgbuild/ && cd /tmp/blocksmith-pkgbuild && makepkg -si`.
pkgname=blocksmith
pkgver=0.54.0
pkgrel=1
pkgdesc="Markdown-Editor für GNOME, der Artikel als WordPress-Gutenberg-Blöcke veröffentlicht"
arch=('x86_64')
url="https://github.com/linuxundich/blocksmith"
license=('GPL-3.0-or-later')
install=blocksmith.install
depends=(
  'gtk4'
  'libadwaita'
  'gtksourceview5'
  'libspelling'
  'webkitgtk-6.0'
  'gdk-pixbuf2'
  'pango'
  'glib2'
  'gcc-libs'
)
# Not `rust`/`cargo` - both already resolve to a working toolchain via
# `rustup` on this machine (`pacman -Q rustup`), and declaring the separate
# official `rust` package here would fight that rather than use it.
makedepends=()
source=()

# Absolute, not relative to $startdir - this file is meant to be copied
# elsewhere before building (see the note above), so a path relative to
# its own location wouldn't reliably point back at the real project.
_projectdir="/home/toff/05_Projekte/blocksmith"

# No build() here on purpose: `ring`'s (a `rustls` dependency, pulled in
# via `ureq`) build script compiles its own C/assembly code, and something
# about makepkg's default LDFLAGS (`--as-needed` is the usual suspect for
# this exact failure mode) makes the linker drop its symbols as
# apparently-unused before they're actually referenced - a plain `cargo
# build --release` run outside makepkg's environment doesn't have this
# problem at all. Rather than fight makepkg's toolchain env, `package()`
# below just reuses the already-built, already-verified-working release
# binary directly - run `cargo build --release` in `_projectdir` yourself
# first if `target/release/blocksmith` isn't there yet or is stale.

package() {
  cd "$_projectdir"
  if [ ! -x target/release/blocksmith ]; then
    error "target/release/blocksmith fehlt - erst 'cargo build --release' in $_projectdir ausführen."
    return 1
  fi
  install -Dm755 target/release/blocksmith "$pkgdir/usr/bin/blocksmith"
  install -Dm644 data/de.christophlangner.Blocksmith.desktop \
    "$pkgdir/usr/share/applications/de.christophlangner.Blocksmith.desktop"
  install -Dm644 data/icons/de.christophlangner.Blocksmith.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/de.christophlangner.Blocksmith.svg"
  install -Dm644 data/de.christophlangner.Blocksmith.metainfo.xml \
    "$pkgdir/usr/share/metainfo/de.christophlangner.Blocksmith.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
