# Regenerates the icon-theme cache and desktop-file database after
# install/upgrade/remove - without this, a *new* icon (this package's own
# first install, or any future icon change) can sit correctly on disk but
# not show up in an already-running GNOME Shell session (or other desktop
# environment) until it's independently refreshed. Pacman's own
# gtk-update-icon-cache.hook only fires when a package touches the
# `hicolor` directory entry itself, not when it merely adds a new file
# under an already-existing `hicolor/scalable/apps/` - which is exactly
# what installing a single app's icon into a shared icon theme does, so
# that hook alone isn't enough here. Best-effort: guarded with `command
# -v` since neither tool is a hard dependency of the app itself, just
# something most desktop systems already have.

post_install() {
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor &>/dev/null || true
  fi
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q &>/dev/null || true
  fi
}

post_upgrade() {
  post_install
}

post_remove() {
  post_install
}
