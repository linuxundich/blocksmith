<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-authored for Blocksmith, based on GitHub's classic light syntax
     highlighting palette - not derived from another GtkSourceView scheme
     file. -->
<style-scheme id="blocksmith-github-light" _name="GitHub Light" version="1.0">
  <author>Blocksmith</author>
  <_description>Light scheme using GitHub's classic syntax highlighting palette</_description>

  <color name="background"    value="#ffffff"/>
  <color name="current-line"  value="#f6f8fa"/>
  <color name="selection"     value="#c8e1ff"/>
  <color name="foreground"    value="#24292e"/>
  <color name="comment"       value="#6a737d"/>
  <color name="red"           value="#d73a49"/>
  <color name="green"         value="#22863a"/>
  <color name="orange"        value="#e36209"/>
  <color name="blue"          value="#005cc5"/>
  <color name="purple"        value="#6f42c1"/>
  <color name="string-blue"   value="#032f62"/>

  <!-- Global Settings -->
  <style name="text"                        foreground="foreground" background="background"/>
  <style name="selection"                   foreground="foreground" background="selection"/>
  <style name="cursor"                      foreground="foreground"/>
  <style name="secondary-cursor"            foreground="comment"/>
  <style name="current-line"                background="current-line"/>
  <style name="current-line-number"         foreground="foreground" background="current-line" bold="true"/>
  <style name="line-numbers"                foreground="comment" background="current-line"/>
  <style name="background-pattern"          background="current-line"/>

  <!-- Bracket Matching -->
  <style name="bracket-match"               foreground="foreground" background="selection" bold="true"/>
  <style name="bracket-mismatch"            foreground="red" background="selection" bold="true"/>

  <!-- Right Margin -->
  <style name="right-margin"                foreground="comment" background="current-line"/>

  <!-- Search Matching -->
  <style name="search-match"                foreground="foreground" background="#fff5b1"/>

  <!-- Comments -->
  <style name="def:comment"                 foreground="comment" italic="true"/>
  <style name="def:shebang"                 foreground="comment" bold="true"/>
  <style name="def:doc-comment-element"     italic="true"/>

  <!-- Constants -->
  <style name="def:constant"                foreground="blue"/>
  <style name="def:special-char"            foreground="blue"/>
  <style name="def:string"                  foreground="string-blue"/>
  <style name="def:number"                  foreground="blue"/>
  <style name="def:floating-point"          foreground="blue"/>
  <style name="def:character"               foreground="string-blue"/>
  <style name="def:boolean"                 foreground="blue"/>
  <style name="def:builtin-constant"        foreground="blue"/>

  <!-- Identifiers -->
  <style name="def:identifier"              foreground="orange"/>

  <!-- Functions -->
  <style name="def:function"                foreground="purple"/>
  <style name="def:builtin"                 foreground="purple" italic="true"/>

  <!-- Keywords -->
  <style name="def:keyword"                 foreground="red"/>
  <style name="def:reserved"                foreground="red" bold="true"/>

  <!-- Statements -->
  <style name="def:statement"               foreground="red"/>

  <!-- Types -->
  <style name="def:type"                    foreground="orange"/>

  <!-- Markup -->
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         bold="true"/>
  <style name="def:inline-code"             foreground="red"/>
  <style name="def:insertion"               underline="single"/>
  <style name="def:deletion"                strikethrough="true"/>
  <style name="def:link-text"               foreground="blue"/>
  <style name="def:link-symbol"             foreground="comment" bold="true"/>
  <style name="def:link-destination"        foreground="string-blue" underline="single"/>
  <style name="def:heading"                 foreground="green" bold="true"/>
  <style name="def:thematic-break"          foreground="comment" bold="true"/>
  <style name="def:preformatted-section"    foreground="orange"/>
  <style name="def:list-marker"             foreground="red" bold="true"/>

  <!-- Operators -->
  <style name="def:operator"                foreground="red"/>

  <!-- Others -->
  <style name="def:preprocessor"            foreground="purple"/>
  <style name="def:error"                   foreground="red" bold="true" underline="error"/>
  <style name="def:warning"                 foreground="orange" bold="true"/>
  <style name="def:note"                    foreground="background" background="#fff5b1" bold="true"/>
  <style name="def:net-address"             foreground="blue" underline="single"/>
</style-scheme>
