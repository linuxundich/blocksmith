<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-authored for Blocksmith, based on Atom's official One Light UI
     palette (https://github.com/atom/atom/tree/master/packages/one-light-ui)
     - not derived from another GtkSourceView scheme file. -->
<style-scheme id="blocksmith-one-light" _name="One Light" version="1.0">
  <author>Blocksmith</author>
  <_description>Light scheme using Atom's One Light color palette</_description>

  <color name="background"    value="#fafafa"/>
  <color name="current-line"  value="#f0f0f1"/>
  <color name="selection"     value="#e5e5e6"/>
  <color name="foreground"    value="#383a42"/>
  <color name="comment"       value="#a0a1a7"/>
  <color name="red"           value="#e45649"/>
  <color name="green"         value="#50a14f"/>
  <color name="yellow"        value="#c18401"/>
  <color name="blue"          value="#4078f2"/>
  <color name="purple"        value="#a626a4"/>
  <color name="cyan"          value="#0184bc"/>
  <color name="orange"        value="#986801"/>

  <!-- Global Settings -->
  <style name="text"                        foreground="foreground" background="background"/>
  <style name="selection"                   foreground="foreground" background="selection"/>
  <style name="cursor"                      foreground="foreground"/>
  <style name="secondary-cursor"            foreground="comment"/>
  <style name="current-line"                background="current-line"/>
  <style name="current-line-number"         foreground="foreground" background="current-line" bold="true"/>
  <style name="line-numbers"                foreground="comment" background="current-line"/>
  <style name="background-pattern"          background="current-line"/>

  <!-- Bracket Matching -->
  <style name="bracket-match"               foreground="foreground" background="selection" bold="true"/>
  <style name="bracket-mismatch"            foreground="red" background="selection" bold="true"/>

  <!-- Right Margin -->
  <style name="right-margin"                foreground="comment" background="current-line"/>

  <!-- Search Matching -->
  <style name="search-match"                foreground="background" background="yellow"/>

  <!-- Comments -->
  <style name="def:comment"                 foreground="comment" italic="true"/>
  <style name="def:shebang"                 foreground="comment" bold="true"/>
  <style name="def:doc-comment-element"     italic="true"/>

  <!-- Constants -->
  <style name="def:constant"                foreground="orange"/>
  <style name="def:special-char"            foreground="cyan"/>
  <style name="def:string"                  foreground="green"/>
  <style name="def:number"                  foreground="orange"/>
  <style name="def:floating-point"          foreground="orange"/>
  <style name="def:character"               foreground="green"/>
  <style name="def:boolean"                 foreground="orange"/>
  <style name="def:builtin-constant"        foreground="orange"/>

  <!-- Identifiers -->
  <style name="def:identifier"              foreground="foreground"/>

  <!-- Functions -->
  <style name="def:function"                foreground="blue"/>
  <style name="def:builtin"                 foreground="cyan" italic="true"/>

  <!-- Keywords -->
  <style name="def:keyword"                 foreground="purple"/>
  <style name="def:reserved"                foreground="purple" bold="true"/>

  <!-- Statements -->
  <style name="def:statement"               foreground="purple"/>

  <!-- Types -->
  <style name="def:type"                    foreground="yellow"/>

  <!-- Markup -->
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         bold="true"/>
  <style name="def:inline-code"             foreground="red"/>
  <style name="def:insertion"               underline="single"/>
  <style name="def:deletion"                strikethrough="true"/>
  <style name="def:link-text"               foreground="blue"/>
  <style name="def:link-symbol"             foreground="comment" bold="true"/>
  <style name="def:link-destination"        foreground="green" underline="single"/>
  <style name="def:heading"                 foreground="red" bold="true"/>
  <style name="def:thematic-break"          foreground="comment" bold="true"/>
  <style name="def:preformatted-section"    foreground="orange"/>
  <style name="def:list-marker"             foreground="purple" bold="true"/>

  <!-- Operators -->
  <style name="def:operator"                foreground="purple"/>

  <!-- Others -->
  <style name="def:preprocessor"            foreground="purple"/>
  <style name="def:error"                   foreground="red" bold="true" underline="error"/>
  <style name="def:warning"                 foreground="orange" bold="true"/>
  <style name="def:note"                    foreground="background" background="yellow" bold="true"/>
  <style name="def:net-address"             foreground="blue" underline="single"/>
</style-scheme>
