<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-authored for Blocksmith, based on the classic Monokai palette
     (originally by Wimer Hazenberg for TextMate) - not derived from
     another GtkSourceView scheme file. -->
<style-scheme id="blocksmith-monokai" _name="Monokai" version="1.0">
  <author>Blocksmith</author>
  <_description>Dark scheme using the classic Monokai color palette</_description>

  <color name="background"    value="#272822"/>
  <color name="current-line"  value="#3e3d32"/>
  <color name="selection"     value="#49483e"/>
  <color name="foreground"    value="#f8f8f2"/>
  <color name="comment"       value="#75715e"/>
  <color name="pink"          value="#f92672"/>
  <color name="green"         value="#a6e22e"/>
  <color name="yellow"        value="#e6db74"/>
  <color name="blue"          value="#66d9ef"/>
  <color name="purple"        value="#ae81ff"/>
  <color name="orange"        value="#fd971f"/>

  <!-- Global Settings -->
  <style name="text"                        foreground="foreground" background="background"/>
  <style name="selection"                   foreground="foreground" background="selection"/>
  <style name="cursor"                      foreground="foreground"/>
  <style name="secondary-cursor"            foreground="comment"/>
  <style name="current-line"                background="current-line"/>
  <style name="current-line-number"         foreground="foreground" background="current-line" bold="true"/>
  <style name="line-numbers"                foreground="comment" background="background"/>
  <style name="background-pattern"          background="current-line"/>

  <!-- Bracket Matching -->
  <style name="bracket-match"               foreground="foreground" background="selection" bold="true"/>
  <style name="bracket-mismatch"            foreground="pink" background="selection" bold="true"/>

  <!-- Right Margin -->
  <style name="right-margin"                foreground="comment" background="current-line"/>

  <!-- Search Matching -->
  <style name="search-match"                foreground="background" background="yellow"/>

  <!-- Comments -->
  <style name="def:comment"                 foreground="comment" italic="true"/>
  <style name="def:shebang"                 foreground="comment" bold="true"/>
  <style name="def:doc-comment-element"     italic="true"/>

  <!-- Constants -->
  <style name="def:constant"                foreground="purple"/>
  <style name="def:special-char"            foreground="purple"/>
  <style name="def:string"                  foreground="yellow"/>
  <style name="def:number"                  foreground="purple"/>
  <style name="def:floating-point"          foreground="purple"/>
  <style name="def:character"               foreground="yellow"/>
  <style name="def:boolean"                 foreground="purple"/>
  <style name="def:builtin-constant"        foreground="purple"/>

  <!-- Identifiers -->
  <style name="def:identifier"              foreground="foreground"/>

  <!-- Functions -->
  <style name="def:function"                foreground="green"/>
  <style name="def:builtin"                 foreground="blue" italic="true"/>

  <!-- Keywords -->
  <style name="def:keyword"                 foreground="pink"/>
  <style name="def:reserved"                foreground="pink" bold="true"/>

  <!-- Statements -->
  <style name="def:statement"               foreground="pink"/>

  <!-- Types -->
  <style name="def:type"                    foreground="blue" italic="true"/>

  <!-- Markup -->
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         bold="true"/>
  <style name="def:inline-code"             foreground="green"/>
  <style name="def:insertion"               underline="single"/>
  <style name="def:deletion"                strikethrough="true"/>
  <style name="def:link-text"               foreground="pink"/>
  <style name="def:link-symbol"             foreground="comment" bold="true"/>
  <style name="def:link-destination"        foreground="blue" underline="single"/>
  <style name="def:heading"                 foreground="green" bold="true"/>
  <style name="def:thematic-break"          foreground="comment" bold="true"/>
  <style name="def:preformatted-section"    foreground="orange"/>
  <style name="def:list-marker"             foreground="pink" bold="true"/>

  <!-- Operators -->
  <style name="def:operator"                foreground="pink"/>

  <!-- Others -->
  <style name="def:preprocessor"            foreground="pink"/>
  <style name="def:error"                   foreground="pink" bold="true" underline="error"/>
  <style name="def:warning"                 foreground="orange" bold="true"/>
  <style name="def:note"                    foreground="background" background="yellow" bold="true"/>
  <style name="def:net-address"             foreground="blue" underline="single"/>
</style-scheme>
