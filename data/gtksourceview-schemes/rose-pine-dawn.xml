<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-authored for Blocksmith, based on the official Rosé Pine Dawn
     palette (https://rosepinetheme.com/palette) - not derived from
     another GtkSourceView scheme file. -->
<style-scheme id="blocksmith-rose-pine-dawn" _name="Rosé Pine Dawn" version="1.0">
  <author>Blocksmith</author>
  <_description>Light scheme using the Rosé Pine Dawn color palette</_description>

  <color name="base"           value="#faf4ed"/>
  <color name="surface"        value="#fffaf3"/>
  <color name="overlay"        value="#f2e9e1"/>
  <color name="highlight-low"  value="#f4ede8"/>
  <color name="highlight-med"  value="#dfdad9"/>
  <color name="muted"          value="#9893a5"/>
  <color name="subtle"         value="#797593"/>
  <color name="text"           value="#575279"/>
  <color name="love"           value="#b4637a"/>
  <color name="gold"           value="#ea9d34"/>
  <color name="rose"           value="#d7827e"/>
  <color name="pine"           value="#286983"/>
  <color name="foam"           value="#56949f"/>
  <color name="iris"           value="#907aa9"/>

  <!-- Global Settings -->
  <style name="text"                        foreground="text" background="base"/>
  <style name="selection"                   foreground="text" background="highlight-med"/>
  <style name="cursor"                      foreground="text"/>
  <style name="secondary-cursor"            foreground="muted"/>
  <style name="current-line"                background="surface"/>
  <style name="current-line-number"         foreground="text" background="surface" bold="true"/>
  <style name="line-numbers"                foreground="muted" background="surface"/>
  <style name="background-pattern"          background="highlight-low"/>

  <!-- Bracket Matching -->
  <style name="bracket-match"               foreground="text" background="highlight-med" bold="true"/>
  <style name="bracket-mismatch"            foreground="love" background="highlight-med" bold="true"/>

  <!-- Right Margin -->
  <style name="right-margin"                foreground="muted" background="surface"/>

  <!-- Search Matching -->
  <style name="search-match"                foreground="base" background="gold"/>

  <!-- Comments -->
  <style name="def:comment"                 foreground="muted" italic="true"/>
  <style name="def:shebang"                 foreground="muted" bold="true"/>
  <style name="def:doc-comment-element"     italic="true"/>

  <!-- Constants -->
  <style name="def:constant"                foreground="gold"/>
  <style name="def:special-char"            foreground="rose"/>
  <style name="def:string"                  foreground="foam"/>
  <style name="def:number"                  foreground="gold"/>
  <style name="def:floating-point"          foreground="gold"/>
  <style name="def:character"               foreground="foam"/>
  <style name="def:boolean"                 foreground="gold"/>
  <style name="def:builtin-constant"        foreground="gold"/>

  <!-- Identifiers -->
  <style name="def:identifier"              foreground="text"/>

  <!-- Functions -->
  <style name="def:function"                foreground="pine"/>
  <style name="def:builtin"                 foreground="foam" italic="true"/>

  <!-- Keywords -->
  <style name="def:keyword"                 foreground="love"/>
  <style name="def:reserved"                foreground="love" bold="true"/>

  <!-- Statements -->
  <style name="def:statement"               foreground="love"/>

  <!-- Types -->
  <style name="def:type"                    foreground="iris"/>

  <!-- Markup -->
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         bold="true"/>
  <style name="def:inline-code"             foreground="rose"/>
  <style name="def:insertion"               underline="single"/>
  <style name="def:deletion"                strikethrough="true"/>
  <style name="def:link-text"               foreground="pine"/>
  <style name="def:link-symbol"             foreground="subtle" bold="true"/>
  <style name="def:link-destination"        foreground="iris" underline="single"/>
  <style name="def:heading"                 foreground="love" bold="true"/>
  <style name="def:thematic-break"          foreground="muted" bold="true"/>
  <style name="def:preformatted-section"    foreground="rose"/>
  <style name="def:list-marker"             foreground="love" bold="true"/>

  <!-- Operators -->
  <style name="def:operator"                foreground="pine"/>

  <!-- Others -->
  <style name="def:preprocessor"            foreground="iris"/>
  <style name="def:error"                   foreground="love" bold="true" underline="error"/>
  <style name="def:warning"                 foreground="gold" bold="true"/>
  <style name="def:note"                    foreground="base" background="gold" bold="true"/>
  <style name="def:net-address"             foreground="pine" underline="single"/>
</style-scheme>
