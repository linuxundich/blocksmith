<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-authored for Blocksmith, based on the official Gruvbox palette
     (https://github.com/morhetz/gruvbox) - not derived from another
     GtkSourceView scheme file. -->
<style-scheme id="blocksmith-gruvbox-light" _name="Gruvbox Light" version="1.0">
  <author>Blocksmith</author>
  <_description>Light scheme using the Gruvbox color palette</_description>

  <color name="bg0"    value="#fbf1c7"/>
  <color name="bg1"    value="#ebdbb2"/>
  <color name="bg2"    value="#d5c4a1"/>
  <color name="fg1"    value="#3c3836"/>
  <color name="fg4"    value="#7c6f64"/>
  <color name="red"    value="#cc241d"/>
  <color name="green"  value="#98971a"/>
  <color name="yellow" value="#d79921"/>
  <color name="blue"   value="#458588"/>
  <color name="purple" value="#b16286"/>
  <color name="aqua"   value="#689d6a"/>
  <color name="orange" value="#d65d0e"/>

  <!-- Global Settings -->
  <style name="text"                        foreground="fg1" background="bg0"/>
  <style name="selection"                   foreground="fg1" background="bg2"/>
  <style name="cursor"                      foreground="fg1"/>
  <style name="secondary-cursor"            foreground="fg4"/>
  <style name="current-line"                background="bg1"/>
  <style name="current-line-number"         foreground="fg1" background="bg1" bold="true"/>
  <style name="line-numbers"                foreground="fg4" background="bg1"/>
  <style name="background-pattern"          background="bg1"/>

  <!-- Bracket Matching -->
  <style name="bracket-match"               foreground="fg1" background="bg2" bold="true"/>
  <style name="bracket-mismatch"            foreground="red" background="bg2" bold="true"/>

  <!-- Right Margin -->
  <style name="right-margin"                foreground="fg4" background="bg1"/>

  <!-- Search Matching -->
  <style name="search-match"                foreground="bg0" background="yellow"/>

  <!-- Comments -->
  <style name="def:comment"                 foreground="fg4" italic="true"/>
  <style name="def:shebang"                 foreground="fg4" bold="true"/>
  <style name="def:doc-comment-element"     italic="true"/>

  <!-- Constants -->
  <style name="def:constant"                foreground="purple"/>
  <style name="def:special-char"            foreground="orange"/>
  <style name="def:string"                  foreground="green"/>
  <style name="def:number"                  foreground="purple"/>
  <style name="def:floating-point"          foreground="purple"/>
  <style name="def:character"               foreground="green"/>
  <style name="def:boolean"                 foreground="purple"/>
  <style name="def:builtin-constant"        foreground="purple"/>

  <!-- Identifiers -->
  <style name="def:identifier"              foreground="fg1"/>

  <!-- Functions -->
  <style name="def:function"                foreground="aqua" bold="true"/>
  <style name="def:builtin"                 foreground="blue" italic="true"/>

  <!-- Keywords -->
  <style name="def:keyword"                 foreground="red"/>
  <style name="def:reserved"                foreground="red" bold="true"/>

  <!-- Statements -->
  <style name="def:statement"               foreground="red"/>

  <!-- Types -->
  <style name="def:type"                    foreground="yellow"/>

  <!-- Markup -->
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         bold="true"/>
  <style name="def:inline-code"             foreground="aqua"/>
  <style name="def:insertion"               underline="single"/>
  <style name="def:deletion"                strikethrough="true"/>
  <style name="def:link-text"               foreground="blue"/>
  <style name="def:link-symbol"             foreground="fg4" bold="true"/>
  <style name="def:link-destination"        foreground="blue" underline="single"/>
  <style name="def:heading"                 foreground="orange" bold="true"/>
  <style name="def:thematic-break"          foreground="fg4" bold="true"/>
  <style name="def:preformatted-section"    foreground="orange"/>
  <style name="def:list-marker"             foreground="red" bold="true"/>

  <!-- Operators -->
  <style name="def:operator"                foreground="orange"/>

  <!-- Others -->
  <style name="def:preprocessor"            foreground="purple"/>
  <style name="def:error"                   foreground="red" bold="true" underline="error"/>
  <style name="def:warning"                 foreground="orange" bold="true"/>
  <style name="def:note"                    foreground="bg0" background="yellow" bold="true"/>
  <style name="def:net-address"             foreground="blue" underline="single"/>
</style-scheme>
