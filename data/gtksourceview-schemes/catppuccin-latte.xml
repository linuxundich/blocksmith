<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-authored for Blocksmith, based on the official Catppuccin Latte
     palette (https://catppuccin.com/palette) - not derived from another
     GtkSourceView scheme file. -->
<style-scheme id="blocksmith-catppuccin-latte" _name="Catppuccin Latte" version="1.0">
  <author>Blocksmith</author>
  <_description>Light scheme using the Catppuccin Latte color palette</_description>

  <color name="base"     value="#eff1f5"/>
  <color name="surface0" value="#ccd0da"/>
  <color name="surface1" value="#bcc0cc"/>
  <color name="overlay0" value="#9ca0b0"/>
  <color name="text"     value="#4c4f69"/>
  <color name="subtext0" value="#6c6f85"/>
  <color name="mauve"    value="#8839ef"/>
  <color name="red"      value="#d20f39"/>
  <color name="peach"    value="#fe640b"/>
  <color name="yellow"   value="#df8e1d"/>
  <color name="green"    value="#40a02b"/>
  <color name="teal"     value="#179299"/>
  <color name="sky"      value="#04a5e5"/>
  <color name="blue"     value="#1e66f5"/>
  <color name="lavender" value="#7287fd"/>

  <!-- Global Settings -->
  <style name="text"                        foreground="text" background="base"/>
  <style name="selection"                   foreground="text" background="surface1"/>
  <style name="cursor"                      foreground="text"/>
  <style name="secondary-cursor"            foreground="overlay0"/>
  <style name="current-line"                background="surface0"/>
  <style name="current-line-number"         foreground="text" background="surface0" bold="true"/>
  <style name="line-numbers"                foreground="overlay0" background="surface0"/>
  <style name="background-pattern"          background="surface0"/>

  <!-- Bracket Matching -->
  <style name="bracket-match"               foreground="text" background="surface1" bold="true"/>
  <style name="bracket-mismatch"            foreground="red" background="surface1" bold="true"/>

  <!-- Right Margin -->
  <style name="right-margin"                foreground="overlay0" background="surface0"/>

  <!-- Search Matching -->
  <style name="search-match"                foreground="base" background="yellow"/>

  <!-- Comments -->
  <style name="def:comment"                 foreground="overlay0" italic="true"/>
  <style name="def:shebang"                 foreground="overlay0" bold="true"/>
  <style name="def:doc-comment-element"     italic="true"/>

  <!-- Constants -->
  <style name="def:constant"                foreground="peach"/>
  <style name="def:special-char"            foreground="peach"/>
  <style name="def:string"                  foreground="green"/>
  <style name="def:number"                  foreground="peach"/>
  <style name="def:floating-point"          foreground="peach"/>
  <style name="def:character"               foreground="green"/>
  <style name="def:boolean"                 foreground="peach"/>
  <style name="def:builtin-constant"        foreground="peach"/>

  <!-- Identifiers -->
  <style name="def:identifier"              foreground="text"/>

  <!-- Functions -->
  <style name="def:function"                foreground="blue"/>
  <style name="def:builtin"                 foreground="sky" italic="true"/>

  <!-- Keywords -->
  <style name="def:keyword"                 foreground="mauve"/>
  <style name="def:reserved"                foreground="mauve" bold="true"/>

  <!-- Statements -->
  <style name="def:statement"               foreground="mauve"/>

  <!-- Types -->
  <style name="def:type"                    foreground="yellow"/>

  <!-- Markup -->
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         bold="true"/>
  <style name="def:inline-code"             foreground="teal"/>
  <style name="def:insertion"               underline="single"/>
  <style name="def:deletion"                strikethrough="true"/>
  <style name="def:link-text"               foreground="blue"/>
  <style name="def:link-symbol"             foreground="overlay0" bold="true"/>
  <style name="def:link-destination"        foreground="lavender" underline="single"/>
  <style name="def:heading"                 foreground="mauve" bold="true"/>
  <style name="def:thematic-break"          foreground="overlay0" bold="true"/>
  <style name="def:preformatted-section"    foreground="peach"/>
  <style name="def:list-marker"             foreground="mauve" bold="true"/>

  <!-- Operators -->
  <style name="def:operator"                foreground="sky"/>

  <!-- Others -->
  <style name="def:preprocessor"            foreground="mauve"/>
  <style name="def:error"                   foreground="red" bold="true" underline="error"/>
  <style name="def:warning"                 foreground="peach" bold="true"/>
  <style name="def:note"                    foreground="base" background="yellow" bold="true"/>
  <style name="def:net-address"             foreground="blue" underline="single"/>
</style-scheme>
